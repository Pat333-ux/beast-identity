import json
import os
import pytest
from jsonschema import validate, ValidationError

def test_identity_schema_exists():
    assert os.path.exists("schemas/citizen_identity_binding_schema.json"), "Identity binding schema missing!"

def test_valid_identity_binding():
    schema_path = "schemas/citizen_identity_binding_schema.json"
    with open(schema_path, "r", encoding="utf-8") as f:
        schema = json.load(f)

    valid_payload = {
        "binding_id": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d",
        "timestamp": "2026-10-22T14:48:00Z",
        "citizen_id": "nwo_citizen_0001",
        "wallet_anchor": "0x71C7656EC7ab88b098defB751B7401B5f6d8976F",
        "activation_state": "ACTIVE",
        "governance_permissions": ["PROPOSAL_VOTE", "ESCROW_CLAIM"],
        "ledger_anchor_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "judicial_compliance_hash": "a1b2c3d4e5f67890abcdef1234567890abcdef1234567890abcdef1234567890",
        "sentinel_verification_sig": "f0e9d8c7b6a543210fedcba9876543210fedcba9876543210fedcba987654321"
    }

    validate(instance=valid_payload, schema=schema)

def test_invalid_wallet_address_fails():
    schema_path = "schemas/citizen_identity_binding_schema.json"
    with open(schema_path, "r", encoding="utf-8") as f:
        schema = json.load(f)

    invalid_payload = {
        "binding_id": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d",
        "timestamp": "2026-10-22T14:48:00Z",
        "citizen_id": "nwo_citizen_0001",
        "wallet_anchor": "0xINVALID_WALLETHASH", # Invalid EVM address format
        "activation_state": "ACTIVE",
        "governance_permissions": ["PROPOSAL_VOTE"],
        "ledger_anchor_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "judicial_compliance_hash": "a1b2c3d4e5f67890abcdef1234567890abcdef1234567890abcdef1234567890",
        "sentinel_verification_sig": "f0e9d8c7b6a543210fedcba9876543210fedcba9876543210fedcba987654321"
    }

    with pytest.raises(ValidationError):
        validate(instance=invalid_payload, schema=schema)
